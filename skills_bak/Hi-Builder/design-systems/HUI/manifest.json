{
  "schema_version": "hui-manifest.v2",
  "maintenance": {
    "purpose": "HUI通用知识总入口，登记运行版本、资源以及各类HUI知识索引。",
    "edit_policy": "只登记经官方资料或现实代码验证的HUI事实；业务字段、产品样式和单页需求写入下级对应知识层。",
    "managed_paths": {
      "runtime-contracts": "HUI原子组件标签、props、events、slots、methods及采集证据。",
      "component-patterns": "HUI通用data-component组合模式及派生词典。",
      "zones": "跨产品统一data-zone业务区域语义。",
      "page-patterns": "HUI通用页面模式与TPP典型页面知识。",
      "theme": "HUI token白名单及产品覆盖边界。"
    }
  },
  "library": "hui-vue",
  "runtime": "vue2",
  "runtime_profile": {
    "vue": {
      "version": "2.7.16",
      "npm_package": "vue",
      "module_mode": "full"
    },
    "hui": {
      "version": "2.61.3",
      "npm_package": "hui",
      "module_mode": "full"
    },
    "preview": "cdn",
    "dialog_binding": ":visible.sync",
    "instance_services": [
      "$message",
      "$notify",
      "$msgbox",
      "$alert",
      "$confirm",
      "$prompt"
    ],
    "forbidden_globals": [
      "ElMessage",
      "ElNotification",
      "ElMessageBox"
    ],
    "icon_modes": [
      "font-class",
      "icon-v2-component",
      "inline-svg-in-h-icon",
      "predefined-svg-in-h-svg-icon"
    ]
  },
