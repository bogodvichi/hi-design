          "可选值": "—",
          "默认值": "false",
          "template_name": "visible"
        },
        {
          "参数": "title",
          "说明": "Dialog 的标题，也可通过具名 slot （见下表）传入",
          "类型": "string",
          "可选值": "—",
          "默认值": "—",
          "template_name": "title"
