          "类型": "boolean",
          "可选值": "—",
          "默认值": "true",
          "template_name": "modal-append-to-body"
        },
        {
          "参数": "append-to-body",
          "说明": "Dialog 自身是否插入至 body 元素上。嵌套的 Dialog 必须指定该属性并赋值为 true",
