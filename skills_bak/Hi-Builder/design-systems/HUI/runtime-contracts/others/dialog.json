          "可选值": "—",
          "默认值": "480",
          "template_name": "area"
        },
        {
          "参数": "no-scrollbar",
          "说明": "可以指定不出现 dialog 容器的滚动条（指定了高度才生效，不指定高度默认无滚动条）",
