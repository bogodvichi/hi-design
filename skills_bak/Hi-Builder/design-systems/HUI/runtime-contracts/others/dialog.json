          "可选值": "tiny/small/large/full",
          "默认值": "small",
          "template_name": "size"
        },
        {
          "参数": "sizeMode   2.53.0+",
          "说明": "Dialog 的尺寸类型，影响dialog的宽度。 percent 时 tiny:30%、small:50%、large:90%； pixel 时 tiny:480px、small:640px、large:960px",
          "类型": "string",
          "可选值": "percent/pixel",
          "默认值": "percent",
          "template_name": "size-mode"
        },
        {
