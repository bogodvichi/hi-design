{
  "schema_version": "pattern-page-spec.v2",
  "industry": "general",
  "product": "isc",
  "product_version": "3.0.0",
  "id": "isc3-permission-approval-list",
  "title": "权限审批",
  "page_kind": "table",
  "pattern_contract": "table/linear-tabs.json",
  "framework": {
    "variant": "regular-09",
    "tabs": [
      {"id": "pending", "label": "待审批"},
      {"id": "approved", "label": "已审批"}
    ],
    "active_tab": "pending"
  },
  "collection_toolbar_variant": "actions-scoped-keyword",
  "portal": {
    "active_top_menu": "门禁管理",
    "active_icon_menu": "authorization",
    "section": "权限管理",
    "tab_title": "权限审批",
    "active_side_menu": "permission-approval",
    "side_menus": [
      {"id": "permission-application", "label": "权限申请", "icon": "h-icon-add"},
      {"id": "permission-approval", "label": "权限审批", "icon": "h-icon-edit"},
      {"id": "permission-delivery", "label": "权限下发", "icon": "h-icon-refresh"}
    ]
  },
  "table_tabs": [
    {"id": "pending", "label": "待审批"},
    {"id": "approved", "label": "已审批"}
  ],
  "filters": [
    {"key": "keyword", "label": "申请单号", "kind": "input", "placeholder": "请输入申请单号", "default": ""},
    {"key": "applicant", "label": "申请人", "kind": "input", "placeholder": "请输入申请人", "default": ""},
    {"key": "organization", "label": "申请人所属组织", "kind": "input", "placeholder": "请输入所属组织", "default": ""},
    {"key": "applicationReason", "label": "申请名称/申请事由", "kind": "input", "placeholder": "请输入申请名称或事由", "default": ""},
    {"key": "accessAreas", "label": "通行区域", "kind": "input", "placeholder": "请输入通行区域", "default": ""},
    {"key": "applicationTime", "label": "申请时间", "kind": "date-range", "placeholder": "请选择申请时间", "default": ""},
    {"key": "permissionValidity", "label": "权限有效期", "kind": "date-range", "placeholder": "请选择权限有效期", "default": ""},
    {"key": "approvalRound", "label": "审批轮次", "kind": "select", "options": ["全部", "第1轮", "第2轮", "第3轮"], "default": "全部"},
    {"key": "overallStatus", "label": "总体审批状态", "kind": "select", "options": ["全部", "待审批", "审批中", "已通过", "已退回", "已撤回", "已失效"], "default": "全部"},
    {"key": "myApprovalResult", "label": "本人审批结果", "kind": "select", "options": ["全部", "已通过", "已退回"], "default": "全部", "tabs": ["approved"]},
    {"key": "approvalTime", "label": "审批时间", "kind": "date-range", "placeholder": "请选择审批时间", "default": "", "tabs": ["approved"]}
  ],
  "toolbar_actions": [
    {
      "id": "batch-approve",
      "label": "批量审批",
      "icon": "h-icon-edit",
      "appearance": "primary",
      "tabs": ["pending"],
      "requires_selection": true,
      "selectable_key": "canApprove",
      "stale_key": "stateChanged",
      "stale_message": "列表状态已发生变化，请刷新后重试",
      "confirm": {
        "title": "确认批量审批",
        "message": "将对选中的 {count} 条申请执行批量审批，确认继续吗？",
        "type": "warning",
        "confirm_button_text": "确认",
        "cancel_button_text": "取消"
      },
      "success_message": "已提交 {count} 条批量审批任务"
    }
  ],
  "row_actions": [
    {"id": "details", "label": "查看详情", "icon": "h-icon-details"},
    {"id": "approve", "label": "审批", "icon": "h-icon-edit", "tabs": ["pending"], "requires_eligible": true}
  ],
  "columns": [
    {"prop": "applicationNo", "label": "申请单号", "fixed_width": 158},
    {"prop": "applicationReason", "label": "申请名称/申请事由", "min_width": 220, "kind": "ellipsis", "tabs": ["pending"]},
    {"prop": "applicant", "label": "申请人", "fixed_width": 90},
    {"prop": "organization", "label": "所属组织", "min_width": 180, "tabs": ["pending"]},
    {"prop": "accessAreas", "label": "涉及通行区域", "min_width": 220, "kind": "ellipsis"},
    {"prop": "currentResponsibleAreas", "label": "当前审批人负责区域", "min_width": 190, "tabs": ["pending"]},
    {"prop": "myResponsibleAreas", "label": "本人负责区域", "min_width": 180, "tabs": ["approved"]},
    {"prop": "permissionValidity", "label": "权限有效期", "fixed_width": 220, "tabs": ["pending"]},
    {"key": "pending-approval-round", "prop": "approvalRound", "label": "当前审批轮次", "fixed_width": 112, "tabs": ["pending"]},
    {"prop": "submitTime", "label": "提交时间", "fixed_width": 168, "tabs": ["pending"]},
    {"key": "pending-overall-status", "prop": "overallStatus", "label": "总体状态", "fixed_width": 100, "kind": "status-tag", "tone_map": {"待审批": "orange", "审批中": "orange", "已通过": "green", "已退回": "red", "已撤回": "orange", "已失效": "red"}, "tabs": ["pending"]},
    {"prop": "myApprovalResult", "label": "本人审批结果", "fixed_width": 112, "kind": "status-tag", "tone_map": {"已通过": "green", "已退回": "red"}, "tabs": ["approved"]},
    {"prop": "myApprovalOpinion", "label": "本人审批意见", "min_width": 200, "kind": "ellipsis", "tabs": ["approved"]},
    {"key": "approved-overall-status", "prop": "overallStatus", "label": "当前总体状态", "fixed_width": 112, "kind": "status-tag", "tone_map": {"待审批": "orange", "审批中": "orange", "已通过": "green", "已退回": "red", "已撤回": "orange", "已失效": "red"}, "tabs": ["approved"]},
    {"prop": "distributionStatus", "label": "权限下发状态", "fixed_width": 112, "kind": "status-tag", "tone_map": {"未下发": "orange", "待下发": "orange", "下发中": "orange", "下发成功": "green", "部分失败": "orange", "下发失败": "red"}, "tabs": ["approved"]},
    {"key": "approved-approval-round", "prop": "approvalRound", "label": "审批轮次", "fixed_width": 96, "tabs": ["approved"]},
    {"prop": "approvalTime", "label": "审批时间", "fixed_width": 168, "tabs": ["approved"]}
  ],
  "page_size": 20,
