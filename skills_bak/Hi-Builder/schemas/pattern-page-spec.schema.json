{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hi-design.pattern-page-spec.v2",
  "title": "HUI TPP Pattern PageSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "industry",
    "product",
    "id",
    "title",
    "page_kind",
    "pattern_contract",
    "portal",
    "preview"
  ],
  "properties": {
    "schema_version": {"const": "pattern-page-spec.v2"},
    "industry": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "product": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "product_version": {"type": "string", "minLength": 1},
    "shell_standard": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "title": {"type": "string", "minLength": 1},
    "page_kind": {"enum": ["form", "table", "card", "switch", "card-tabs", "details"]},
    "pattern_contract": {"type": "string", "minLength": 1},
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {"required": ["variant"]},
        {"required": ["show_left_selector", "show_top_tabs", "business_header"]}
      ],
      "properties": {
        "variant": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "show_left_selector": {"type": "boolean"},
        "show_top_tabs": {"type": "boolean"},
        "business_header": {
          "enum": ["none", "intro", "intro-actions", "intro-actions-extra"]
        },
        "show_variant_menu": {"type": "boolean"},
        "intro": {"type": "string", "minLength": 1},
        "global_actions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "extra_info": {"type": "string", "minLength": 1},
        "tabs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "label": {"type": "string", "minLength": 1},
              "icon": {"$ref": "#/$defs/iconRef"},
              "disabled": {"type": "boolean"}
            }
          }
        },
        "active_tab": {"type": "string", "minLength": 1},
        "selector_title": {"type": "string", "minLength": 1},
        "selector_search_placeholder": {"type": "string", "minLength": 1},
        "selector_nodes": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/treeNode"}
        },
        "selector_active_node": {"type": "string", "minLength": 1},
        "selector_expanded_nodes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "knowledge_composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secondary_pattern_contract", "reason", "expected_contribution"],
      "properties": {
        "secondary_pattern_contract": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "expected_contribution": {"enum": ["summary.metrics", "filter.instant-filter"]}
      }
    },
    "alternate_pattern_contract": {"type": "string", "minLength": 1},
    "default_view": {"enum": ["card", "table"]},
    "detail_presentation": {"enum": ["card", "flat"]},
    "detail_columns": {"type": "integer", "minimum": 1, "maximum": 4},
    "collection_toolbar_variant": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "collection_toolbar_filter_expanded": {"type": "boolean"},
    "portal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_top_menu", "section", "tab_title", "active_side_menu", "side_menus"],
      "properties": {
        "active_top_menu": {"type": "string", "minLength": 1},
        "active_icon_menu": {"type": "string", "minLength": 1},
        "show_context_sidebar": {"type": "boolean"},
        "section": {"type": "string", "minLength": 1},
        "tab_title": {"type": "string", "minLength": 1},
        "active_side_menu": {"type": "string", "minLength": 1},
        "side_menus": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sideMenu"}}
      }
    },
    "filters": {"type": "array", "items": {"type": "object"}},
    "toolbar_actions": {"type": "array", "items": {"type": "object"}},
    "row_actions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/rowAction"}
    },
    "summary_metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label"],
          "properties": {
            "key": {"type": "string", "minLength": 1},
            "label": {"type": "string", "minLength": 1},
            "icon": {"type": "string", "minLength": 1},
            "image_icon": {"type": "string", "minLength": 1},
            "filter_key": {"type": "string", "minLength": 1},
            "filter_value": {"type": "string", "minLength": 1}
        }
      }
    },
    "columns": {"type": "array", "items": {"type": "object"}},
    "field_configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description", "library_title", "configured_title",
        "field_type_options", "library_add_action", "add_action"
      ],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "library_title": {"type": "string", "minLength": 1},
        "configured_title": {"type": "string", "minLength": 1},
        "field_type_options": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "library_add_action": {"$ref": "#/$defs/fieldConfigurationAction"},
        "add_action": {"$ref": "#/$defs/fieldConfigurationAction"}
      }
    },
    "card_fields": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label", "role"],
        "properties": {
          "key": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "role": {"enum": ["primary", "metadata", "status"]}
        }
      }
    },
    "page_size": {"type": "integer", "minimum": 1},
    "schedule_view_modes": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"enum": ["day", "week", "month"]}},
    "default_schedule_presentation": {"enum": ["table", "calendar"]},
    "default_schedule_view": {"enum": ["day", "week", "month"]},
    "detail_tabs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "sections"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "sections": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/detailSection"}
          }
        }
      }
    },
    "detail_drawer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "section_title", "fields"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "section_title": {"type": "string", "minLength": 1},
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "label", "control"],
            "properties": {
              "key": {"type": "string", "minLength": 1},
              "label": {"type": "string", "minLength": 1},
              "control": {"enum": ["input", "textarea"]}
            }
          }
        }
      }
    },
    "form_sections": {"type": "array", "items": {"type": "object"}},
    "form_tabs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": {"type": "string"},
          "label": {"type": "string"},
          "section_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "form_actions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "row_detail_href": {"type": "string", "minLength": 1},
    "form_return_href": {"type": "string", "minLength": 1},
    "card_tabs": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/cardTab"}
    },
    "table_tabs": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1}
        }
      }
    },
    "tree_nodes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/treeNode"}
    },
    "default_tree_node": {"type": "string", "minLength": 1},
    "summary_fields": {"type": "array", "items": {"$ref": "#/$defs/detailField"}},
    "detail_sections": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/detailSection"}},
    "active_detail_section": {"type": "string", "minLength": 1},
    "related_tables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "columns"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "columns": {"type": "array", "items": {"type": "object"}}
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alt"],
      "properties": {"alt": {"type": "string", "minLength": 1}}
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "formModel": {"type": "object"},
        "filters": {"type": "object"},
        "summaryMetrics": {"type": "object"},
        "rows": {"type": "array", "items": {"type": "object"}},
        "scheduleItems": {"type": "array", "items": {"type": "object"}},
        "total": {"type": "integer", "minimum": 0},
        "cardTabRows": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "object"}}},
        "tableTabRows": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "object"}}},
        "fieldLibraryByTab": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "object"}}},
        "configuredFieldsByTab": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "object"}}},
        "detailValues": {"type": "object"},
        "relatedTableRows": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "object"}}},
        "detailMedia": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "src": {"type": "string", "minLength": 1},
            "thumbnails": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    }
  },
  "$defs": {
    "fieldConfigurationAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "icon", "appearance"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "label": {"type": "string", "minLength": 1},
        "icon": {"type": "string", "pattern": "^h-icon-[A-Za-z0-9_-]+$"},
        "appearance": {"enum": ["default", "primary"]}
      }
    },
    "rowAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "icon"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "label": {"type": "string", "minLength": 1},
        "icon": {"type": "string", "pattern": "^h-icon-[A-Za-z0-9_-]+$"},
        "tabs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "requires_eligible": {"type": "boolean"}
      }
    },
    "sideMenu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "icon"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "icon": {"type": "string", "pattern": "^h-icon-[A-Za-z0-9_-]+$"},
        "href": {"type": "string", "minLength": 1},
        "children": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "label": {"type": "string", "minLength": 1},
              "href": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "iconRef": {
      "oneOf": [
        {"type": "string", "pattern": "^h-icon-[A-Za-z0-9_-]+$"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "name"],
          "properties": {
            "mode": {"enum": ["font", "icon-v2", "business-svg"]},
            "name": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "detailField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "tone": {"enum": ["default", "success", "warning", "danger", "info"]},
        "kind": {"enum": ["text", "image", "card", "password", "biometric"]}
      }
    },
    "detailSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "fields"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "fields": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/detailField"}}
      }
    },
    "cardTab": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "card_profile", "pattern_contract"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "card_profile": {"type": "string", "minLength": 1},
        "pattern_contract": {"type": "string", "minLength": 1}
      }
    },
    "treeNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "filter_key": {"type": "string", "minLength": 1},
        "filter_value": {"type": "string", "minLength": 1},
        "children": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/treeNode"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"page_kind": {"const": "switch"}}},
      "then": {"required": ["alternate_pattern_contract", "default_view"]}
    },
    {
      "if": {"properties": {"page_kind": {"const": "card-tabs"}}},
      "then": {"required": ["card_tabs"]}
    },
    {
      "if": {"properties": {"pattern_contract": {"const": "card/card-tabs-with-tree.json"}}},
      "then": {"required": ["tree_nodes", "default_tree_node"]}
    },
    {
      "if": {"properties": {"page_kind": {"const": "details"}}},
      "then": {
        "anyOf": [
          {"required": ["detail_sections"]},
          {"required": ["detail_tabs"]}
        ]
      }
    }
  ]
}
