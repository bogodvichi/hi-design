  "product": "isc",
  "id": "vehicle-alarm-statistics-table",
  "title": "车辆报警",
  "page_kind": "table",
  "pattern_contract": "table/horizontal-realtime-filter.json",
  "portal": {
    "active_top_menu": "车辆通行",
