    ]
  },
  "filters": [
    {"key": "plateNo", "label": "车牌号码", "kind": "input", "placeholder": "请输入车牌号码", "default": ""},
    {"key": "alarmType", "label": "报警类型", "kind": "select", "options": ["全部", "黑名单车辆", "陌生车辆", "频繁出入", "超速行驶"], "default": "全部"},
    {"key": "handleStatus", "label": "处置状态", "kind": "select", "options": ["全部", "未处置", "处置中", "已处置"], "default": "全部"},
    {"key": "alarmLevel", "label": "报警级别", "kind": "select", "options": ["全部", "高", "中", "低"], "default": "全部"},
    {"key": "checkpoint", "label": "报警点位", "kind": "input", "placeholder": "请输入报警点位", "default": ""}
  ],
  "toolbar_actions": [
    {"label": "批量处置", "icon": "h-icon-edit"},
    {"label": "导出", "icon": "h-icon-export"}
  ],
  "summary_metrics": [
    {"key": "alarmTotal", "label": "报警总数", "icon": "h-icon-menu", "image_icon": "h-icon-menu"},
    {"key": "highRisk", "label": "高风险", "icon": "h-icon-edit", "image_icon": "h-icon-edit", "filter_key": "riskStatus", "filter_value": "高风险"},
    {"key": "abnormal", "label": "异常", "icon": "h-icon-home", "image_icon": "h-icon-home", "filter_key": "riskStatus", "filter_value": "异常"},
    {"key": "attention", "label": "关注", "icon": "h-icon-export", "image_icon": "h-icon-export", "filter_key": "riskStatus", "filter_value": "关注"}
  ],
  "columns": [
    {"prop": "alarmLevel", "label": "报警级别"},
    {"prop": "plateNo", "label": "车牌号码"},
    {"prop": "vehicleType", "label": "车辆类型"},
    {"prop": "alarmType", "label": "报警类型"},
    {"prop": "checkpoint", "label": "报警点位"},
    {"prop": "handlingProgress", "label": "处置进度", "kind": "progress", "fixed_width": 240},
    {"prop": "riskSummary", "label": "风险统计", "kind": "tag-pair", "status_prop": "riskStatus", "metric_prop": "riskPercentage", "tone_prop": "riskTone", "fixed_width": 140},
    {"prop": "alarmTime", "label": "报警时间"},
    {"prop": "handleStatus", "label": "处置状态"}
  ],
  "detail_tabs": [
