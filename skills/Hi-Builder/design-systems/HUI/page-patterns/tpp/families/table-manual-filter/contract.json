{
  "schema_version": "hui-page-pattern.v1",
  "id": "hui.tpp.family.table-manual-filter",
  "name": "手动过滤表格页",
  "source": {
    "platform": "HUI-VUE典型页面",
    "observed_at": "2026-07-31",
    "catalog": "../../catalog.json"
  },
  "match": [
    "manual-filter-table",
    "手动过滤",
    "过滤盒"
  ],
  "semantics": [
    "explicit-filter-controls",
    "query-action",
    "reset-action",
    "data-table"
  ],
  "shared_runtime_components": [
    "el-button",
    "el-checkbox",
    "el-divider",
    "el-input",
    "el-option",
    "el-pagination",
    "el-radio-button",
    "el-radio-group",
    "el-scrollbar",
    "el-select",
    "el-table",
    "el-table-column",
    "el-tag",
    "el-tooltip",
    "h-icon",
    "h-svg-icon"
  ],
  "invariants": {
    "regions": {
      "toolbar": {
        "display": "flex",
        "position": "static",
        "gap": "normal",
        "overflow_x": "visible",
        "overflow_y": "visible",
        "height": 56
      },
      "table": {
        "display": "flex",
        "position": "relative",
        "padding": "0px",
        "gap": "normal",
        "overflow_x": "hidden",
        "overflow_y": "hidden"
      },
      "pagination": {
        "display": "flex",
        "position": "static",
        "padding": "0px 12px",
        "gap": "normal",
        "overflow_x": "visible",
        "overflow_y": "visible",
        "height": 56
      }
    },
    "variant_values_must_come_from_page_contract": true
  },
  "variants": [
    {
      "id": "hui.tpp.page.table.regular-filter-box-high-low",
      "name": "常规过滤盒（高低频）",
      "contract": "../../pages/table/regular-filter-box-high-low.json",
      "parameters": {
        "filter_placement": "regular-box",
        "collapse_mode": "high-low-frequency"
      }
    },
    {
      "id": "hui.tpp.page.table.regular-filter-box-fully-retractable",
      "name": "常规过滤盒（全量可收起）",
      "contract": "../../pages/table/regular-filter-box-fully-retractable.json",
      "parameters": {
        "filter_placement": "regular-box",
        "collapse_mode": "all-retractable"
      }
    },
    {
      "id": "hui.tpp.page.table.horizontal-filter-high-low",
      "name": "水平栏过滤（高低频）",
      "contract": "../../pages/table/horizontal-filter-high-low.json",
      "parameters": {
        "filter_placement": "horizontal-bar",
        "collapse_mode": "high-low-frequency"
      }
    },
    {
      "id": "hui.tpp.page.table.horizontal-filter-fully-retractable",
      "name": "水平栏过滤（全量可收起）",
      "contract": "../../pages/table/horizontal-filter-fully-retractable.json",
      "parameters": {
        "filter_placement": "horizontal-bar",
        "collapse_mode": "all-retractable"
      }
    },
    {
      "id": "hui.tpp.page.table.sidebar-manual-filter",
      "name": "侧边栏过滤",
      "contract": "../../pages/table/sidebar-manual-filter.json",
      "parameters": {
        "filter_placement": "left-sidebar",
        "trigger": "manual"
      }
    }
  ]
}
