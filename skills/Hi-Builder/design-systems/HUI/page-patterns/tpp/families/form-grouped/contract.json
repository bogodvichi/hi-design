        "display": "flex",
        "position": "static",
        "gap": "normal",
        "overflow_x": "visible",
        "overflow_y": "visible"
      },
      "form": {
        "display": "block",
        "position": "static",
        "padding": "0px",
        "gap": "normal",
        "overflow_x": "visible",
        "overflow_y": "visible"
      }
    },
    "variant_values_must_come_from_page_contract": true
  },
  "variants": [
    {
      "id": "hui.tpp.page.form.first-level-grouping",
      "name": "一级分组",
      "contract": "../../pages/form/first-level-grouping.json",
      "parameters": {
        "group_depth": 1,
        "container_count": 1,
        "columns": 3,
        "form_item_gap": "24px",
        "title_field_gap": "24px",
        "group_gap": "48px",
        "default_label_position": null
      }
    },
    {
      "id": "hui.tpp.page.form.second-level-grouping",
      "name": "二级分组",
      "contract": "../../pages/form/second-level-grouping.json",
      "parameters": {
        "group_depth": 2,
        "container_count": 1,
        "default_label_position": null
      }
    }
  ]
}
