{
  "schema_version": "hui-page-pattern.v1",
  "id": "hui.tpp.family.form-grouped",
  "name": "分组表单页",
  "source": {
    "platform": "HUI-VUE典型页面",
    "observed_at": "2026-07-31",
    "catalog": "../../catalog.json"
  },
  "match": [
    "grouped-form",
    "分组表单",
    "一级分组",
    "二级分组"
  ],
  "semantics": [
    "section-groups",
    "group-title",
    "responsive-field-grid",
    "sticky-footer-actions"
  ],
  "shared_runtime_components": [
    "el-checkbox",
    "el-col",
    "el-form",
    "el-form-item",
    "el-input",
    "el-option",
    "el-radio",
    "el-radio-group",
    "el-row",
    "el-scrollbar",
    "el-select",
    "el-tag",
    "el-tooltip",
    "el-upload",
    "h-svg-icon"
  ],
  "invariants": {
