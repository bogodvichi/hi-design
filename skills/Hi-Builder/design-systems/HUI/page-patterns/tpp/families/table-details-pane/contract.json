    },
    "details_spacing": {
      "content_end_padding": "24px",
      "pane_width": "455px",
      "pane_padding": "8px 0px 40px 24px",
      "tabs_content_padding": "8px 0px",
      "container_margin": "0px -20px",
      "item_padding": "0px 0px 0px 20px",
      "item_margin": "0px 0px 24px",
      "title_height": "22px"
    },
    "regions": {
      "search": {
        "display": "block",
        "position": "static",
        "padding": "16px 0px",
        "gap": "normal",
        "overflow_x": "visible",
        "overflow_y": "visible",
        "height": 109
      },
      "toolbar": {
        "display": "flex",
        "position": "static",
        "padding": "0px",
        "gap": "normal",
        "overflow_x": "visible",
        "overflow_y": "visible",
        "height": 56
      },
      "table": {
        "display": "flex",
        "position": "relative",
        "padding": "0px",
        "gap": "normal",
        "overflow_x": "hidden",
        "overflow_y": "hidden",
        "height": 628.66
      },
      "pagination": {
        "display": "flex",
        "position": "static",
        "padding": "0px 12px",
        "gap": "normal",
        "overflow_x": "visible",
        "overflow_y": "visible",
        "height": 56
      },
      "tabs": {
        "display": "block",
        "position": "static",
        "padding": "0px",
        "gap": "normal",
        "overflow_x": "visible",
        "overflow_y": "visible",
        "height": 692.66
      },
      "details_content": {
        "display": "flex",
        "position": "relative",
        "padding": "0px 12px",
        "gap": "normal",
        "overflow_x": "visible",
        "overflow_y": "visible",
        "height": 849.66
      }
    },
    "variant_values_must_come_from_page_contract": true
  },
  "variants": [
    {
      "id": "hui.tpp.page.table.with-details-pane",
