        "owner": ".query-filter::after",
        "mechanism": "pseudo-element",
        "placement": "filter-bottom",
        "width": "1px",
        "token": "--h-color-border-tertiary"
      },
      "master_details": {
        "mechanism": "border",
        "edge": "left",
        "token": "--h-color-border-tertiary"
      }
    },
    "layout_relation": {
      "shape": "T-shaped",
      "details_scope": "inside table collection module",
