{
  "schema_version": "hui-page-pattern.v1",
  "id": "hui.tpp.family.table-details-pane",
  "name": "详情栏表格页",
  "source": {
    "platform": "HUI-VUE典型页面",
    "observed_at": "2026-07-31",
    "catalog": "../../catalog.json"
  },
  "match": [
    "details-pane-table",
    "带详情栏"
  ],
  "semantics": [
    "master-table",
    "selection-linked-details",
    "details-pane"
  ],
  "shared_runtime_components": [
    "el-button",
    "el-checkbox",
    "el-divider",
    "el-form",
    "el-form-item",
    "el-input",
    "el-option",
    "el-pagination",
    "el-radio-button",
    "el-radio-group",
    "el-scrollbar",
    "el-select",
    "el-tab-pane",
    "el-table",
    "el-table-column",
    "el-tabs",
    "el-tag",
    "el-tooltip",
    "h-icon",
    "h-svg-icon"
  ],
  "invariants": {
